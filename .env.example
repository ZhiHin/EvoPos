# ---------------------------------------------------------------------------
# Restaurant Operating System - environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Public base URL of the app. Used to build OAuth redirect URIs.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
#
# Two connection strings on purpose. This is the backbone of tenant isolation:
#
#   DATABASE_URL            -> role `ros_app`. Used by the running application.
#                              NOT the table owner, has no BYPASSRLS. Every
#                              query it issues is filtered by row-level
#                              security policies.
#
#   DATABASE_URL_MIGRATOR   -> role `ros_owner`. Owns the tables, runs DDL and
#                              migrations. Never used to serve a request.
#
# If the app ever connected as the owner, RLS would be silently bypassed and
# every tenant would see every other tenant's data.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://ros_app:change_me_app@localhost:5432/ros
DATABASE_URL_MIGRATOR=postgresql://ros_owner:change_me_owner@localhost:5432/ros

# ---------------------------------------------------------------------------
# Auth
#
# AUTH_SECRET is used as the HMAC key for hashing session tokens and one-time
# tokens before they are stored. Must be at least 32 characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
AUTH_SECRET=

# Google OAuth. Leave both blank to disable Google login.
# Authorised redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
